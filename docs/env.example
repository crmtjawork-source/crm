# Copy to apps/web/.env.local (never commit it) and set the same values in
# Vercel → Project → Settings → Environment Variables. Names + purpose only.
# Full reference: docs/HANDOVER.md §8.

# ---- Required -------------------------------------------------------------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Background job (automations, reminders, push, retries) --------------
# Any long random string, e.g. `openssl rand -hex 32`. The same value goes
# into Supabase Vault by scripts/setup/03-cron.sql.
CRON_SECRET=
# Public URL of the deployed app (links inside messages). No trailing slash.
APP_URL=http://localhost:3000

# ---- WhatsApp via a self-hosted Evolution API server (docs/HANDOVER.md §6) -
EVOLUTION_URL=
EVOLUTION_API_KEY=

# ---- Web Push (`npx web-push generate-vapid-keys`) ------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Google Calendar (optional; needs a Google Cloud OAuth client) --------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string; signs the OAuth state parameter.
OAUTH_STATE_SECRET=

# ---- Meta: WhatsApp Cloud API, Embedded Signup, Lead Ads (optional) -------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_ES_CONFIG_ID=

# ---- Drizzle only (packages/db, optional) --------------------------------
DATABASE_URL=
